{
  "manifest_version": 3,
  "name": "DopamineGuard",
  "version": "1.2",
  "description": "A simple local-only website blocker for intentional browsing.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "DopamineGuard",
    "default_popup": "options.html"
  }
}