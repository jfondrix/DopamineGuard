{
  "manifest_version": 3,
  "name": "Focus Extension",
  "version": "1.1",
  "description": "Blocks distracting websites.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Focus Extension",
    "default_popup": "options.html"
  }
}